# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ADMIN_PASSWORD: Secret password to access the studio admin portal.
# Configure this in Vercel > Project Settings > Environment Variables.
# Note: In Vite apps, environment variables exposed to the client must start with VITE_.
VITE_ADMIN_PASSWORD=

# Sanity (server-backed catalog — permanent memory).
# Project ID for the fifeart project (see studio-fifeart/sanity.config.ts).
VITE_SANITY_PROJECT_ID=s2an63e9
# Dataset name (default: production).
VITE_SANITY_DATASET=production
# Optional: read API token. Only needed if the dataset is private.
# If set, also add the site origin (e.g. https://fifeart.com) to the
# project's CORS origins at https://www.sanity.io/manage.
VITE_SANITY_API_TOKEN=
# Optional: write token letting the Studio Admin publish About-page edits
# (and portrait uploads) straight to Sanity for all visitors.
# WARNING: VITE_ variables ship in public JS — anyone can read this token,
# so treat it as semi-public and rotate it if abused. Editor role is enough.
VITE_SANITY_WRITE_TOKEN=
